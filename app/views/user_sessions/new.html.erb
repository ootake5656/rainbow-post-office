<main class="authentication-page">
  <section class="authentication-page__content">
    <h1>ログイン</h1>

    <%= form_with url: login_path, class: "authentication-page__form" do |form| %>
      <div>
        <%= form.label :email, "メールアドレス" %>
        <%= form.email_field :email,
                             value: @email,
                             autocomplete: "email",
                             required: true %>
      </div>

      <div>
        <%= form.label :password, "パスワード" %>
        <%= form.password_field :password,
                                autocomplete: "current-password",
                                required: true %>
      </div>

      <%= form.submit "ログイン" %>
    <% end %>

    <p>
      初めての方は<%= link_to "新規登録", new_user_path %>
    </p>
  </section>
</main>
