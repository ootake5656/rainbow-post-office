<main class="sent-letter">
  <section class="sent-letter__content">
    <header class="sent-letter__header">
      <p class="sent-letter__date"><%= l @letter.sent_at, format: :short %></p>
      <h1 class="sent-letter__title"><%= @pet.name %>ちゃんへの手紙</h1>
    </header>

    <article class="sent-letter__body">
      <%= simple_format(@letter.content) %>
    </article>

    <% if @reply %>
      <%= link_to "対応する返事を読む",
                  reply_path(@reply),
                  class: "sent-letter__reply-link" %>
    <% else %>
      <p class="sent-letter__waiting">管理人からの返事を待っています</p>
    <% end %>

    <%= link_to "手紙一覧へ戻る",
                letters_path,
                class: "sent-letter__back-link sent-letter__back-link--secondary" %>
  </section>
</main>
