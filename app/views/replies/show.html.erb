<main class="reply-letter">
  <section class="reply-letter__content">
    <header class="reply-letter__header">
      <p class="reply-letter__sender">管理人からの手紙</p>
      <h1 class="reply-letter__title">
        <%= @pet.name %>ちゃんへの手紙のお返事
      </h1>
    </header>

    <article class="reply-letter__body">
      <%= simple_format(@reply.content) %>
    </article>

    <%= link_to "この返事に対応する手紙を読む",
                letter_path(@letter),
                class: "reply-letter__home-link" %>

    <%= link_to "手紙一覧へ戻る",
                letters_path,
                class: "reply-letter__list-link" %>
  </section>
</main>
